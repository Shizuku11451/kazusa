+#ifdef KRKR2_DESKTOP_HOST
+    if(!layer->IsMainWindow() || !TVPMainScene::DesktopHostMode() ||
+       caption.empty())
+        return;
+    if(auto *glview =
+           static_cast<GLViewImpl *>(Director::getInstance()->getOpenGLView()))
+        glfwSetWindowTitle(glview->getWindow(), caption.c_str());
+#else
+    (void)layer;
+    (void)caption;
+#endif
+}
