+void TVPMainScene::fitHostWindow(const cocos2d::Size &gameSize) {
+#ifdef KRKR2_DESKTOP_HOST
+    if(!DesktopHostMode() || gameSize.width < 1 || gameSize.height < 1 ||
+       gameSize.equals(_fittedGameSize))
+        return;
+    _fittedGameSize = gameSize;
+    auto *glview =
+        static_cast<GLViewImpl *>(Director::getInstance()->getOpenGLView());
+    if(!glview || glview->isFullscreen())
+        return;
+
+    // Fit inside 85% of the monitor; scale small games up to ~1280 wide.
+    cocos2d::Size monitor = glview->getMonitorSize();
+    float scale = std::max(1.f, 1280.f / gameSize.width);
+    if(monitor.width > 0 && monitor.height > 0)
+        scale = std::min({ scale, monitor.width * 0.85f / gameSize.width,
+                           monitor.height * 0.85f / gameSize.height });
+    const float fw = std::round(gameSize.width * scale);
+    const float fh = std::round(gameSize.height * scale);
+
+    glview->setFrameSize(fw, fh);
+    cocos2d::Size design = glview->getDesignResolutionSize();
+    design.width = design.height * fw / fh;
+    glview->setDesignResolutionSize(design.width, design.height,
+                                    ResolutionPolicy::SHOW_ALL);
+    Director::getInstance()->setViewport();
+    if(monitor.width > 0 && monitor.height > 0)
+        glfwSetWindowPos(glview->getWindow(), int((monitor.width - fw) / 2),
+                         int((monitor.height - fh) / 2));
+
+    ScreenRatio = fh / design.height;
+    setContentSize(design);
+    if(_background)
+        _background->setContentSize(design);
+    GameNode->setContentSize(design);
+    UINode->setContentSize(design);
+    UISize = design;
+    TVPWindowLayer::RelayoutAll(design);
+#else
+    (void)gameSize;
+#endif
+}
+
+void TVPHostWindowDidResizeGame(TVPWindowLayer *, const cocos2d::Size &size) {
+    if(auto *scene = TVPMainScene::GetInstance())
+        scene->fitHostWindow(size);
+}
